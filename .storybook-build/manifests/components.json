        {
          "id": "ui-planejamento-de-viagem--interativo",
          "name": "Interativo",
          "snippet": "const Interativo = args => {\r\n    const [origem, setOrigem] = useState(args.origem);\r\n    const [destino, setDestino] = useState(args.destino);\r\n    const [salvo, setSalvo] = useState(args.salvo);\r\n\r\n    return (\r\n        <PlanejamentoDeViagem\r\n            origem={origem}\r\n            destino={destino}\r\n            salvo={salvo}\r\n            onSalvar={() => {\r\n              setSalvo(!salvo);\r\n              args.onSalvar?.();\r\n            }}\r\n            onInverter={() => {\r\n              setOrigem(destino);\r\n              setDestino(origem);\r\n              args.onInverter?.();\r\n            }} />\r\n    );\r\n};"
        }
      ],
